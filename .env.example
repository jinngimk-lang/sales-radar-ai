VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://localhost:8787

# Server-side URL discovery for stateless Discover and Market Radar. Exa finds
# candidate public pages, but candidates still pass the commercial-intent gate
# before they can become visible buyer/seller leads.
# Keep this key in the hosting provider's secret environment; never expose it
# through VITE_* variables or commit a real value.
EXA_API_KEY=
EXA_SEARCH_TIMEOUT_MS=8000

# Preferred page-content acquisition for search evidence. When configured,
# Crawl4AI fetches candidate pages before ranking so buyer/seller/procurement
# signals are judged from page content instead of generic search snippets.
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT_MS=5000
CRAWL4AI_MAX_RESULTS=5

# Revenue cloud-browser keys and operator tokens are backend-only hosting
# variables. Never add BROWSERBASE_API_KEY or REVENUE_OPERATOR_TOKEN here.
