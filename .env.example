VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://localhost:8787

# Preferred Vercel stateless Discover search provider. The full backend already
# reaches Exa through Agent Reach / mcporter; when BACKEND_ORIGIN is absent the
# Vercel fallback can call Exa directly with the same server-side credential.
# Keep this key in the hosting provider's secret environment; never expose it
# through VITE_* variables or commit a real value.
EXA_API_KEY=
EXA_SEARCH_TIMEOUT_MS=8000

# Optional secondary page-depth enrichment. When configured, Crawl4AI can crawl
# public URLs after discovery. Exa remains the primary search/discovery engine.
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT_MS=5000
CRAWL4AI_MAX_RESULTS=5

# Revenue cloud-browser keys and operator tokens are backend-only hosting
# variables. Never add BROWSERBASE_API_KEY or REVENUE_OPERATOR_TOKEN here.
