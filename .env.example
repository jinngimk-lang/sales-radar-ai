VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://localhost:8787

# Optional Vercel stateless-search enrichment. When BACKEND_ORIGIN is absent,
# Discover search can use the same Crawl4AI /crawl contract as the full backend.
# Keep tokens in the hosting provider's secret environment; never commit them.
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT_MS=5000
CRAWL4AI_MAX_RESULTS=5

# Revenue cloud-browser keys and operator tokens are backend-only hosting
# variables. Never add BROWSERBASE_API_KEY or REVENUE_OPERATOR_TOKEN here.
