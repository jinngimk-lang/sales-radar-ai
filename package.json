{
  "name": "sales-radar-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered global customer discovery platform - Sales Radar AI",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "test": "tsx --test src/features/radar/radar-workspace.test.ts src/features/market-intelligence/market-browser-layout.test.ts src/features/command-center/result-presentation.test.ts src/features/command-center/intelligence-result-table.test.ts src/pages/account-capabilities.test.ts src/pages/account-runtime-resilience.test.ts src/pages/revenue-console.test.ts src/pages/ai-command-center.test.ts src/pages/interaction-controls.test.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
