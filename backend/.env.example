NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_radar_ai?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ===== Unified AI Provider Platform =====
# Supported sales-AI providers: qwen, glm, kimi, openai, rule-based.
# Select exactly one active provider. Keys stay server-side and must be issued
# by the provider or an authorized gateway account you control.
AI_PROVIDER=qwen
AI_TIMEOUT_MS=30000

# Optional universal overrides. Leave empty to use the selected provider's
# dedicated variables below.
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Alibaba Cloud DashScope / Qwen OpenAI-compatible API
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# Zhipu BigModel / GLM OpenAI-compatible API
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

# Moonshot AI / Kimi OpenAI-compatible API
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# ===== Hosted Market Web Research =====
# Web research remains a separate capability. It currently uses OpenAI
# Responses, Qwen Responses-compatible access, or Exa; selecting GLM/Kimi for
# sales AI does not claim that those providers have web-search access.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MARKET_MODEL=gpt-5.6
MARKET_RESEARCH_MODEL=qwen3.7-plus
MARKET_RESEARCH_TIMEOUT_MS=60000

# ===== GPT Sales Agent =====
# Add OPENAI_API_KEY to the Railway backend Service / Production environment.
# The browser receives only model IDs and never receives this key.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_TOOL_ROUNDS=6

# ===== Experimental Agent Reach Provider =====
AGENT_REACH_MCPORTER_PATH=mcporter
EXA_API_KEY=
AGENT_REACH_TIMEOUT_MS=15000
AGENT_REACH_MIN_INTERVAL_MS=1500
AGENT_REACH_MAX_RESULTS=10

# ===== Revenue Cloud Browser Operations =====
# Generate a long random operator token and store it only in Railway. The
# revenue page asks for this value and keeps it in sessionStorage for the
# current tab. Never expose either value through VITE_* variables.
REVENUE_OPERATOR_TOKEN=
BROWSERBASE_API_KEY=
BROWSERBASE_BASE_URL=https://api.browserbase.com

# Disabled by default because cloud-browser runs can consume provider quota.
# When enabled, the backend immediately runs one eligible read-only research
# task and then repeats at the configured interval (minimum 5 minutes).
REVENUE_LIVE_LOOP_ENABLED=false
REVENUE_LIVE_LOOP_INTERVAL_MINUTES=30
