NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_radar_ai?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ===== Unified AI Provider Platform =====
# Defaults to the local rule-based provider when empty or unavailable.
AI_PROVIDER=qwen
AI_MODEL=qwen-plus
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=15000

# ===== Hosted Market Web Research =====
# OpenAI Responses API is preferred when this key is configured.
# Keep all credentials server-side; never expose them through VITE_* variables.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MARKET_MODEL=gpt-5.6
# When OPENAI_API_KEY is empty and AI_PROVIDER=qwen, the existing Qwen key and
# base URL are reused. Set a Responses-compatible Qwen model when needed.
MARKET_RESEARCH_MODEL=qwen3.7-plus
MARKET_RESEARCH_TIMEOUT_MS=60000

# ===== Experimental Agent Reach Provider =====
# Executable used for Exa MCP calls. Keep the default when mcporter is on PATH.
AGENT_REACH_MCPORTER_PATH=mcporter
# Used by the local Exa MCP runtime. Never commit a real key.
EXA_API_KEY=
AGENT_REACH_TIMEOUT_MS=15000
# Space concurrent provider requests to reduce avoidable Exa rate-limit bursts.
AGENT_REACH_MIN_INTERVAL_MS=1500
# Hard-capped at 10 by the provider.
AGENT_REACH_MAX_RESULTS=10
